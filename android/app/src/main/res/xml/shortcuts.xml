<?xml version="1.0" encoding="utf-8"?>
<!-- Puts the paired Mac in the share sheet's top row (Direct Share). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.macndroid.ui.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="app.macndroid.category.SEND_TO_MAC" />
    </share-target>
    <!-- "Open on <Mac>" for links: opens them in the Mac's browser. -->
    <share-target android:targetClass="app.macndroid.ui.OpenOnMacActivity">
        <data android:mimeType="text/plain" />
        <category android:name="app.macndroid.category.OPEN_ON_MAC" />
    </share-target>
</shortcuts>
