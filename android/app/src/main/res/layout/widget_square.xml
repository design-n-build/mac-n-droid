<?xml version="1.0" encoding="utf-8"?>
<!-- The widget at 2×2: whether sharing is on, the computer, and two labelled buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp">
                <ImageView
                    android:id="@+id/on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_circle_on"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_stat_logo"
                    android:tint="@color/w_on_primary" />
                <ImageView
                    android:id="@+id/off"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_circle_off"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_stat_logo"
                    android:tint="@color/w_off_icon"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/status_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Sharing on"
                android:textColor="@color/w_text"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/status_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MacBook"
            android:textColor="@color/w_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/c_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_art_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:id="@+id/c_pause_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_pause"
                android:tint="@color/w_btn_icon" />
            <TextView
                android:id="@+id/c_pause_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Pause"
                android:textColor="@color/w_btn_icon"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_art_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">
            <ImageView
                android:id="@+id/c_files_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_upload"
                android:tint="@color/w_btn_icon" />
            <TextView
                android:id="@+id/c_files_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Files"
                android:textColor="@color/w_btn_icon"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
