<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 "Controls and music": what's playing on the computer (Play on phone), then Pause, Send files, Send
     clipboard and Open. Smaller sizes hide parts (Widgets.kt). Also the preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/music"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/art_frame"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_art_bg"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/art_placeholder"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_w_music"
                    android:tint="@color/w_btn_icon" />
                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Golden Hour Drive"
                    android:textColor="@color/w_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Playing on your computer"
                    android:textColor="@color/w_text2"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/here_small"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Play on phone"
                android:padding="10dp"
                android:src="@drawable/ic_phone_handoff"
                android:tint="@color/w_btn_icon" />
            <ImageView
                android:id="@+id/play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_on"
                android:contentDescription="Play or pause"
                android:padding="10dp"
                android:src="@drawable/ic_w_pause"
                android:tint="@color/w_on_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/prev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Previous"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_prev"
                android:tint="@color/w_btn_icon" />
            <ImageView
                android:id="@+id/next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Next"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_next"
                android:tint="@color/w_btn_icon" />
            <LinearLayout
                android:id="@+id/here"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_phone_handoff"
                    android:tint="@color/w_btn_icon" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Play on phone"
                    android:textColor="@color/w_btn_icon"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="Nothing playing on your computer"
        android:textColor="@color/w_text2"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
            <ImageView
                android:id="@+id/a_pause"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Pause sharing"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_pause"
                android:tint="@color/w_btn_icon" />
            <ImageView
                android:id="@+id/a_files"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Send files"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_upload"
                android:tint="@color/w_btn_icon" />
            <ImageView
                android:id="@+id/a_clip"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Send clipboard"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clipboard"
                android:tint="@color/w_btn_icon" />
            <ImageView
                android:id="@+id/a_open"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="Open Mac n Droid"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stat_logo"
                android:tint="@color/w_btn_icon" />
    </LinearLayout>
</LinearLayout>
