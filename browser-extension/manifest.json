{
  "manifest_version": 3,
  "name": "Mac n Droid",
  "version": "0.10.3",
  "description": "Control music and videos playing in your browser from your Android phone, and send pages and links to it. Needs the Mac n Droid app.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Mac n Droid" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "contextMenus", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
