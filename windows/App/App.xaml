<?xml version="1.0" encoding="utf-8"?>
<!-- The UI is built in C#, but WinUI still needs this file: from it the build generates the type information for
     every control the app uses (WinUI's own and the Community Toolkit's settings cards). Without it the app
     crashes as its first window is drawn. -->
<Application
    x:Class="MacNDroid.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A borderless icon button (WinUI 1.6 has no SubtleButtonStyle of its own): clear until hovered. -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
