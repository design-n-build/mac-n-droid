<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Nap: the notch and notifications must react the moment the phone sends something, even when
	     none of Mac n Droid's windows are on screen (for example when Stage Manager has them in the strip). -->
	<key>NSAppSleepDisabled</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>MacNDroid</string>
	<key>CFBundleIdentifier</key><string>app.macndroid.mac</string>
	<key>CFBundleName</key><string>Mac n Droid</string>
	<key>CFBundleDisplayName</key><string>Mac n Droid</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>__VERSION__</string>
	<key>CFBundleVersion</key><string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key><string>14.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<key>NSHumanReadableCopyright</key><string>Free and open source.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mac n Droid connects to your Android phone over your local Wi-Fi network to sync notifications, clipboard and files.</string>
	<key>NSBonjourServices</key>
	<array><string>_macndroid._tcp</string></array>
	<key>SUFeedURL</key>
	<string>https://github.com/santosh-mudragada-1/mac-n-droid/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>E7ffdKnvElZafD/8/7ymQAg20BBVNBOvg7ljRliJO5Q=</string>
	<key>SUEnableAutomaticChecks</key><true/>
	<key>SUScheduledCheckInterval</key><integer>86400</integer>
	<key>NSAppleEventsUsageDescription</key>
	<string>Mac n Droid reads the page open in your browser when you send it to your phone, and plays, pauses or skips Music and Spotify when you use the controls on your phone.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Open on Phone</string></dict>
			<key>NSMessage</key><string>openOnPhone</string>
			<key>NSPortName</key><string>Mac n Droid</string>
			<key>NSSendTypes</key><array><string>public.url</string><string>public.utf8-plain-text</string></array>
			<key>NSRequiredContext</key><dict/>
		</dict>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Send to Phone</string></dict>
			<key>NSMessage</key><string>sendToPhone</string>
			<key>NSPortName</key><string>Mac n Droid</string>
			<key>NSSendFileTypes</key><array><string>public.item</string></array>
			<key>NSRequiredContext</key><dict/>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Any File</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>public.item</string></array>
		</dict>
	</array>
</dict>
</plist>
